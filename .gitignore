# Gradle
.gradle/
build/
*/build/

# Java / JVM build artifacts
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Keep Gradle wrapper jar — required to run ./gradlew on CI
!gradle/wrapper/gradle-wrapper.jar

# Logs and runtime dumps
*.log
logs/
log/
*.out

# IDE/editor
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local env/config overrides
.env
.env.*

# Temporary files
*.tmp
*.swp
*~

# Generated experiment/runtime artifacts
.node-red-custom*/
# Node-RED userDirs are auto-created by run_full_project.ps1 on first start;
# their bootstrap content (node_modules, lib, backups) must never be committed.
# Ignoring the dirs does NOT untrack the settings/config subsets already
# committed for older labs (gitignore has no effect on tracked files).
.node-red-lab*/
benchmark/results/
benchmark/results.archive_*/
bench_step_log_*.csv
benchmark_results_*.csv
metrics_stereotypes_*.csv
# Phase 2 adapt runtime artifacts. NEVER commit these: every CI adapt job's
# artifact upload globs recovery_stereotypes_*.csv from the checkout root, and
# the aggregate step's first-copy-wins reconstruction would then prefer a
# stale committed file over the run's real result (contaminated run
# 29115969476 — 7 cells shadowed by leftovers committed in df53b71).
recovery_stereotypes_*.csv
metrics_adapted_stereotypes_*.csv
coverage_stereotypes_*.csv
first_goal_stereotypes_*.csv
learned_stereotypes_*.ttl
iv_stats_*.json
qtable_*.csv
# The Phase-1 protocol-v2 archive is permanent evidence, not runtime
# leftovers.  Keep every downloaded artifact byte committable even when its
# filename matches one of the generated-artifact patterns above.
!results/phase1_v2_corrected/**
nr_custom*_*.txt
java_pid*.hprof

# Phase 3 (process dynamics) runtime artifacts — regenerated by every
# taskDynamics / run_phase3_dynamics.ps1 run (kept local like the Phase 1/2
# *_stereotypes_* artifacts above; the canonical copies live in CI artifacts
# and the published 'results' branch).
dynamics_delays_*.csv
timebounded_results_*.csv
learned_dynamics_*.ttl

# Python cache
__pycache__/
*.pyc

# Stray work-in-progress markers (do not commit)
*.TODO

# Parallel orchestrator clone tree (sibling of project root)
../*-clones/

# Analysis generated outputs
analysis/out/
analysis/.tmp_validate_qgap_tests/

# Local scratch output folders
tmp_step0_*/
tmp_paper_results/
tmp_step2_validation/

# Build output resource copies
bin/

# Research papers / PDFs
*.pdf

# Python virtual environments
.venv/
venv/

# Phase-1b pilot raw artifact trees stay local (PILOT_ONLY markers, the
# diagnostics CSV and the power inputs/report are committed explicitly).
results/exploratory/phase1b_pilot/run_*/*/
results/exploratory/phase1b_pilot/staged/

# Raw immutable inputs for the retrospective Phase-1b truncated-curve analysis.
# Recreated by scripts/download_phase1b_truncation_inputs.ps1; only the small
# verified analysis outputs are committed.
/.phase1b_truncation_inputs/
/.tmp_phase1b_trunc/

# Phase-2b-A rescued source artifacts are immutable local evidence. Their
# verified ZIPs live outside Git; the extracted ~2.1 GB trees are rebuilt
# from those ZIPs and bound by results/exploratory/phase2b_qgap/analysis/source_manifest.json.
/results/exploratory/phase2b_qgap/source/

# Small raw data sets of three accepted archives are tracked so that their
# reproducers run on a plain clone (analysis/check_pins.py --run-reproducers).
# The larger raw trees of the other archives (Q-tables, adaptation logs,
# per-cell artifacts) stay ignored and local.
!results/phase2_v2_corrected/run_*/recovery_root/**
!results/phase2_v3_structonly/run_*/recovery_root/**
!results/phase3_v2_corrected/run_*/dynamics_root/**
