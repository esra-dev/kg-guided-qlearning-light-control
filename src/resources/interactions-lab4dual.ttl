@prefix td:     <https://www.w3.org/2019/wot/td#> .
@prefix hctl:   <https://www.w3.org/2019/wot/hypermedia#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix eve:    <http://w3id.org/eve#> .
@prefix wotsec: <https://www.w3.org/2019/wot/security#> .
@prefix js:     <https://www.w3.org/2019/wot/json-schema#> .
@prefix htv:    <http://www.w3.org/2011/http#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ============================================================================
#  Thing Description (W3C Web of Things) of lab4dual, the room in which each
#  zone's lamp is behind its own smart plug; flow
#  simulator/simulator_flow_lab4dual.json, base URL
#  http://localhost:1901/was/rl/.
#  Named by td("classpath:interactions-lab4dual.ttl") of the profile lab4dual
#  in src/agt/lab_profiles.asl (Phase 4); LabEnvironment reads it.
#  - Property "Status" (GET .../status): zone light levels Z1Level, Z2Level
#    (lux), the switch positions Z1Light, Z2Light, Z1Blinds, Z2Blinds,
#    Spotlight, PlugZ1, PlugZ2, the sun level Sunshine (lux), the energy
#    counters EnergyCost, TotalEnergyCost, and the simulated Hour.
#  - Actions (POST .../action, one boolean each): SetZ1Light, SetZ2Light,
#    SetZ1Blinds, SetZ2Blinds, SetSpotlight, SetPlugZ1, SetPlugZ2. A lamp emits
#    light only while its zone's plug is also on.
#  The flow's /setState, /reset and /health endpoints are not described here;
#  LabEnvironment derives the /setState and /reset URLs from the action URL.
# ============================================================================

<urn:kg-ql:interactions-lab4dual> a td:Thing, eve:Artifact, <https://example.org/was#Lab> ;

    td:title "The lab of the Interactions team – Lab 4-Dual Smart-Plug" ;
    td:hasSecurityConfiguration [ a wotsec:NoSecurityScheme ] ;
    td:hasBase <http://localhost:1901/was/rl/> ;

    td:hasPropertyAffordance [
        a td:PropertyAffordance, <https://example.org/was#Status>, js:ObjectSchema ;
        td:name "Status" ;
        dct:title "Read the lab status" ;
        td:hasForm [
            htv:methodName "GET" ;
            hctl:hasTarget <http://localhost:1901/was/rl/status> ;
            hctl:forContentType "application/json" ;
            hctl:hasOperationType td:readProperty
        ] ;
        td:isObservable false ;
        js:properties
            [ a js:NumberSchema, <http://example.org/was#Z1Level> ;
              js:propertyName "Z1Level" ],
            [ a js:NumberSchema, <http://example.org/was#Z2Level> ;
              js:propertyName "Z2Level" ],
            [ a js:BooleanSchema, <http://example.org/was#Z1Light> ;
              js:propertyName "Z1Light" ],
            [ a js:BooleanSchema, <http://example.org/was#Z2Light> ;
              js:propertyName "Z2Light" ],
            [ a js:BooleanSchema, <http://example.org/was#Z1Blinds> ;
              js:propertyName "Z1Blinds" ],
            [ a js:BooleanSchema, <http://example.org/was#Z2Blinds> ;
              js:propertyName "Z2Blinds" ],
            [ a js:BooleanSchema, <http://example.org/was#Spotlight> ;
              js:propertyName "Spotlight" ],
            [ a js:BooleanSchema, <http://example.org/was#PlugZ1> ;
              js:propertyName "PlugZ1" ],
            [ a js:BooleanSchema, <http://example.org/was#PlugZ2> ;
              js:propertyName "PlugZ2" ],
            [ a js:NumberSchema, <http://example.org/was#Sunshine> ;
              js:propertyName "Sunshine" ],
            [ a js:NumberSchema, <http://example.org/was#TotalEnergyCost> ;
              js:propertyName "TotalEnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#EnergyCost> ;
              js:propertyName "EnergyCost" ],
            [ a js:NumberSchema, <http://example.org/was#Hour> ;
              js:propertyName "Hour" ]
    ] ;

    td:hasActionAffordance
        [ a td:ActionAffordance, <http://example.org/was#SetZ1Light> ;
          td:name "Control Lights Z1" ;
          dct:title "Turn on and off the lights in Z1 (only emits light if PlugZ1 is also ON)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z1Light" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetZ2Light> ;
          td:name "Control Lights Z2" ;
          dct:title "Turn on and off the lights in Z2 (only emits light if PlugZ2 is also ON)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z2Light" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetZ1Blinds> ;
          td:name "Control Blinds Z1" ;
          dct:title "Raise and lower the blinds in Z1" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z1Blinds" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetZ2Blinds> ;
          td:name "Control Blinds Z2" ;
          dct:title "Raise and lower the blinds in Z2" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Z2Blinds" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetSpotlight> ;
          td:name "Control Spotlight" ;
          dct:title "Turn on and off the shared spotlight (affects both zones equally, +150 lux)" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "Spotlight" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetPlugZ1> ;
          td:name "Control Smart Plug Z1" ;
          dct:title "Toggle the smart plug that powers the Z1 ceiling lamp" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "PlugZ1" ]
          ]
        ],
        [ a td:ActionAffordance, <http://example.org/was#SetPlugZ2> ;
          td:name "Control Smart Plug Z2" ;
          dct:title "Toggle the smart plug that powers the Z2 ceiling lamp" ;
          td:hasForm [
              htv:methodName "POST" ;
              hctl:hasTarget <http://localhost:1901/was/rl/action> ;
              hctl:forContentType "application/json" ;
              hctl:hasOperationType td:invokeAction
          ] ;
          td:hasInputSchema [ a js:ObjectSchema ;
              js:properties [ a js:BooleanSchema ; js:propertyName "PlugZ2" ]
          ]
        ] .
